# Free keys: https://console.groq.com/keys and https://aistudio.google.com/apikey
GROQ_API_KEY=gsk_your_actual_groq_api_key_here
GEMINI_API_KEY=your_actual_gemini_api_key_here

# Optional: Jarvis's voice (free Microsoft neural voices). Examples:
#   en-IN-PrabhatNeural (default, Indian English male)   en-IN-NeerjaNeural (Indian English female)
#   en-US-AndrewMultilingualNeural                       hi-IN-MadhurNeural (Hindi)
# JARVIS_VOICE=en-IN-PrabhatNeural
# JARVIS_VOICE_RATE=+8%

# Optional: search engine used by web_search ({query} is replaced)
# SEARCH_URL=https://www.google.com/search?q={query}

# Optional: where write_code saves programs (default: ~/Documents/jarvis_code)
# CODE_WORKSPACE=D:\projects\jarvis_code

# Optional: 1 = ask yes/no before EVERY action (default: only risky ones)
# CONFIRM_ALL_ACTIONS=0
